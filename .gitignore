# Your books, characters and downloaded spells: they stay on your computer
data/

# Rules text downloaded on first start (SRD conditions, dndtools metamagic feats)
web/conditions.json
web/metamagic.json

# Personal notes and assistant instructions
CLAUDE.md
.claude/
personal/

# The files a ZIP copy had before its first update (kept to go back if the new version doesn't start)
.update-previous/

# Windows: the git Grimoire downloads for its updates when the computer has none (MinGit)
.git-tools/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.tmp

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
